DATABASE_URL=postgresql://social:social_local_only@127.0.0.1:5432/social
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000
AUTH_TRUST_HOST=true
# Local: messages are written to .local/mail, never logged to console.
MAIL_TRANSPORT=file
MAIL_FROM=Community <noreply@example.test>
# Production requires MAIL_TRANSPORT=smtp and a verified sender.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# Enable only behind a proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
SEED_DEMO=false
# SEED_PASSWORD=set-a-long-local-demo-password
# Email (lowercase, comma-separated) allowed on /moderazione. Empty = nobody.
# ADMIN_EMAILS=owner@example.test
