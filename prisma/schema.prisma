generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum Visibility {
  PUBLIC
  FRIENDS
  PRIVATE
}

enum MessagePermission {
  FRIENDS
  EVERYONE
  NOBODY
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum MediaStatus {
  PENDING
  READY
}

enum NotificationType {
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  POST_LIKE
  POST_COMMENT
  PROFILE_VIEW
  MESSAGE
}

model User {
  id                String     @id @default(uuid()) @db.Uuid
  email             String     @unique @db.VarChar(254)
  emailVerified     DateTime?   @map("email_verified") @db.Timestamptz(3)
  passwordHash      String?    @map("password_hash")
  name              String     @db.VarChar(60)
  image             String?
  status            UserStatus @default(ACTIVE)
  sessionVersion    Int        @default(0) @map("session_version")
  lastSeenAt        DateTime?  @map("last_seen_at") @db.Timestamptz(3)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  profile           Profile?
  accounts          Account[]
  sessions          Session[]
  passwordResetTokens PasswordResetToken[]
  friendshipsLow    Friendship[] @relation("FriendLow")
  friendshipsHigh   Friendship[] @relation("FriendHigh")
  sentRequests      FriendRequest[] @relation("RequestSender")
  receivedRequests  FriendRequest[] @relation("RequestRecipient")
  blocks            Block[] @relation("Blocker")
  blockedBy         Block[] @relation("Blocked")
  media             MediaAsset[]
  posts             Post[]
  comments          Comment[]
  likes             Like[]
  views             ProfileView[]
  notifications     Notification[] @relation("NotificationRecipient")
  notificationsActed Notification[] @relation("NotificationActor")
  conversationsLow  Conversation[] @relation("ConversationLow")
  conversationsHigh Conversation[] @relation("ConversationHigh")
  participations    ConversationParticipant[]

  @@index([createdAt, id])
  @@map("users")
}

model Profile {
  id                String @id @default(uuid()) @db.Uuid
  userId            String @unique @map("user_id") @db.Uuid
  username          String @unique @db.VarChar(24)
  bio               String @default("") @db.VarChar(500)
  city              String? @db.VarChar(80)
  birthDate         DateTime? @map("birth_date") @db.Date
  visibility        Visibility @default(PUBLIC)
  discoverable      Boolean @default(true)
  showOnline        Boolean @default(false) @map("show_online")
  recordVisits      Boolean @default(false) @map("record_visits")
  showVisitors      Boolean @default(false) @map("show_visitors")
  notifyVisits      Boolean @default(false) @map("notify_visits")
  messagePermission MessagePermission @default(FRIENDS) @map("message_permission")
  avatarId          String? @map("avatar_id") @db.Uuid
  coverId           String? @map("cover_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user              User @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatar            MediaAsset? @relation("ProfileAvatar", fields: [avatarId], references: [id], onDelete: SetNull)
  cover             MediaAsset? @relation("ProfileCover", fields: [coverId], references: [id], onDelete: SetNull)
  views             ProfileView[]

  @@index([createdAt, id])
  @@map("profiles")
}

model Account {
  id                String @id @default(uuid()) @db.Uuid
  userId            String @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String @id @default(uuid()) @db.Uuid
  sessionToken String @unique @map("session_token")
  userId       String @map("user_id") @db.Uuid
  expires      DateTime @db.Timestamptz(3)
  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String @unique
  expires    DateTime @db.Timestamptz(3)

  @@unique([identifier, token])
  @@index([expires])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @map("user_id") @db.Uuid
  tokenHash String @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Friendship {
  id         String @id @default(uuid()) @db.Uuid
  userLowId  String @map("user_low_id") @db.Uuid
  userHighId String @map("user_high_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  userLow    User @relation("FriendLow", fields: [userLowId], references: [id], onDelete: Cascade)
  userHigh   User @relation("FriendHigh", fields: [userHighId], references: [id], onDelete: Cascade)

  @@unique([userLowId, userHighId])
  @@index([userLowId, createdAt, id])
  @@index([userHighId, createdAt, id])
  @@map("friendships")
}

model FriendRequest {
  id          String @id @default(uuid()) @db.Uuid
  senderId    String @map("sender_id") @db.Uuid
  recipientId String @map("recipient_id") @db.Uuid
  status      RequestStatus @default(PENDING)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  respondedAt DateTime? @map("responded_at") @db.Timestamptz(3)
  sender      User @relation("RequestSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   User @relation("RequestRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([recipientId, status, createdAt, id])
  @@index([senderId, status, createdAt, id])
  @@map("friend_requests")
}

model Block {
  id        String @id @default(uuid()) @db.Uuid
  blockerId String @map("blocker_id") @db.Uuid
  blockedId String @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  blocker   User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId, blockerId])
  @@map("blocks")
}

model MediaAsset {
  id         String @id @default(uuid()) @db.Uuid
  ownerId    String @map("owner_id") @db.Uuid
  storageKey String @unique @map("storage_key")
  mimeType   String @map("mime_type")
  size       Int
  width      Int
  height     Int
  status     MediaStatus @default(PENDING)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  owner      User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  avatars    Profile[] @relation("ProfileAvatar")
  covers     Profile[] @relation("ProfileCover")
  postImages PostImage[]

  @@index([ownerId, createdAt, id])
  @@map("media_assets")
}

model Post {
  id         String @id @default(uuid()) @db.Uuid
  authorId   String @map("author_id") @db.Uuid
  body       String @default("") @db.VarChar(5000)
  visibility Visibility @default(FRIENDS)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  author     User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  images     PostImage[]
  comments   Comment[]
  likes      Like[]
  notifications Notification[]

  @@index([authorId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("posts")
}

model PostImage {
  id       String @id @default(uuid()) @db.Uuid
  postId   String @map("post_id") @db.Uuid
  assetId  String @map("asset_id") @db.Uuid
  position Int
  alt      String? @db.VarChar(300)
  post     Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  asset    MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([postId, position])
  @@unique([postId, assetId])
  @@index([assetId])
  @@map("post_images")
}

model Comment {
  id        String @id @default(uuid()) @db.Uuid
  postId    String @map("post_id") @db.Uuid
  authorId  String @map("author_id") @db.Uuid
  body      String @db.VarChar(2000)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  post      Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([postId, createdAt, id])
  @@index([authorId])
  @@map("comments")
}

model Like {
  userId    String @map("user_id") @db.Uuid
  postId    String @map("post_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId])
  @@map("likes")
}

model ProfileView {
  id        String @id @default(uuid()) @db.Uuid
  viewerId  String @map("viewer_id") @db.Uuid
  profileId String @map("profile_id") @db.Uuid
  viewedAt  DateTime @default(now()) @map("viewed_at") @db.Timestamptz(3)
  viewer    User @relation(fields: [viewerId], references: [id], onDelete: Cascade)
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([profileId, viewedAt(sort: Desc), id(sort: Desc)])
  @@index([viewerId, profileId, viewedAt(sort: Desc)])
  @@map("profile_views")
}

model Notification {
  id             String @id @default(uuid()) @db.Uuid
  recipientId    String @map("recipient_id") @db.Uuid
  actorId        String? @map("actor_id") @db.Uuid
  type           NotificationType
  friendRequestId String? @map("friend_request_id") @db.Uuid
  postId         String? @map("post_id") @db.Uuid
  commentId      String? @map("comment_id") @db.Uuid
  profileViewId  String? @map("profile_view_id") @db.Uuid
  conversationId String? @map("conversation_id") @db.Uuid
  dedupeKey      String? @unique @map("dedupe_key")
  readAt         DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  recipient      User @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor          User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  friendRequest  FriendRequest? @relation(fields: [friendRequestId], references: [id], onDelete: SetNull)
  post           Post? @relation(fields: [postId], references: [id], onDelete: SetNull)
  comment        Comment? @relation(fields: [commentId], references: [id], onDelete: SetNull)
  profileView    ProfileView? @relation(fields: [profileViewId], references: [id], onDelete: SetNull)
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([recipientId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([actorId])
  @@index([friendRequestId])
  @@index([postId])
  @@index([commentId])
  @@index([profileViewId])
  @@index([conversationId])
  @@map("notifications")
}

model Conversation {
  id            String @id @default(uuid()) @db.Uuid
  userLowId     String @map("user_low_id") @db.Uuid
  userHighId    String @map("user_high_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lastMessageAt DateTime? @map("last_message_at") @db.Timestamptz(3)
  userLow       User @relation("ConversationLow", fields: [userLowId], references: [id], onDelete: Cascade)
  userHigh      User @relation("ConversationHigh", fields: [userHighId], references: [id], onDelete: Cascade)
  participants  ConversationParticipant[]
  messages      Message[]
  notifications Notification[]

  @@unique([userLowId, userHighId])
  @@index([userHighId])
  @@map("conversations")
}

model ConversationParticipant {
  conversationId   String @map("conversation_id") @db.Uuid
  userId           String @map("user_id") @db.Uuid
  joinedAt         DateTime @default(now()) @map("joined_at") @db.Timestamptz(3)
  lastReadMessageId String? @map("last_read_message_id") @db.Uuid
  archivedAt       DateTime? @map("archived_at") @db.Timestamptz(3)
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user             User @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages         Message[] @relation("MessageSender")

  @@id([conversationId, userId])
  @@index([userId, conversationId])
  @@map("conversation_participants")
}

model Message {
  id             String @id @default(uuid()) @db.Uuid
  conversationId String @map("conversation_id") @db.Uuid
  senderId       String @map("sender_id") @db.Uuid
  clientId       String @map("client_id") @db.Uuid
  body           String @db.VarChar(5000)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         ConversationParticipant @relation("MessageSender", fields: [conversationId, senderId], references: [conversationId, userId], onDelete: Cascade)

  @@unique([conversationId, senderId, clientId])
  @@unique([conversationId, id])
  @@index([conversationId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("messages")
}

model RateLimitBucket {
  key         String @id
  count       Int @default(1)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("rate_limit_buckets")
}
